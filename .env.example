# Neon escribe estas variables en .env.local mediante neon deploy / neon env pull.
# No copiar credenciales al frontend ni versionar .env.local.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=production
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_ENDPOINT_URL_S3=
AWS_REGION=us-east-2

# Configuración opcional de la API.
PORT=3000
STORAGE_BUCKET=assets

# Proceso externo de correo: npm run notifications:deliver --workspace backend.
# Requiere la migración del outbox y un remitente verificado de Resend.
RESEND_API_KEY=
MAIL_FROM="Biblioteca Digital Universitaria <avisos@mail.uniread.tech>"
PUBLIC_WEB_ORIGIN=
