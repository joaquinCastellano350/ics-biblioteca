{
  "name": "@ics-biblioteca/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run db:generate && tsx watch src/server.ts",
    "build": "npm run db:generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "tsx --test test/*.test.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "test:integration": "tsx --test test/integration/*.test.ts",
    "check:services": "tsx scripts/check-services.ts"
  },
  "description": "API y reglas de negocio de la Biblioteca Digital Universitaria",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1155.0",
    "@aws-sdk/s3-request-presigner": "^3.1155.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/validator": "^13.15.10",
    "prisma": "^7.10.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2"
  }
}
