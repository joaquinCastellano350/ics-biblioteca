generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model University {
  id    String @id @default(uuid()) @db.Uuid
  name  String
  users User[]

  @@map("universities")
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  firstName    String        @map("first_name")
  lastName     String        @map("last_name")
  universityId String        @map("university_id") @db.Uuid
  email        String        @unique
  passwordHash String        @map("password_hash")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  university   University    @relation(fields: [universityId], references: [id], onDelete: Restrict)
  sessions     Session[]
  loans        Loan[]
  queueEntries QueueEntry[]
  reservations Reservation[]

  @@map("users")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model Book {
  id           String        @id @default(uuid()) @db.Uuid
  title        String        @db.Text
  titleSearch  String        @map("title_search") @db.Text
  pdfObjectKey String        @map("pdf_object_key") @db.Text
  totalCopies  Int           @map("total_copies")
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  authors      BookAuthor[]
  subjects     BookSubject[]
  loans        Loan[]
  queueEntries QueueEntry[]
  reservations Reservation[]

  @@map("books")
}

model Author {
  id    String       @id @default(uuid()) @db.Uuid
  name  String       @db.Text
  books BookAuthor[]

  @@map("authors")
}

model Subject {
  id    String        @id @default(uuid()) @db.Uuid
  name  String        @db.Text
  books BookSubject[]

  @@map("subjects")
}

model BookAuthor {
  bookId   String @map("book_id") @db.Uuid
  authorId String @map("author_id") @db.Uuid
  book     Book   @relation(fields: [bookId], references: [id], onDelete: Restrict)
  author   Author @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@id([bookId, authorId])
  @@index([authorId, bookId])
  @@map("book_authors")
}

model BookSubject {
  bookId    String  @map("book_id") @db.Uuid
  subjectId String  @map("subject_id") @db.Uuid
  book      Book    @relation(fields: [bookId], references: [id], onDelete: Restrict)
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Restrict)

  @@id([bookId, subjectId])
  @@index([subjectId, bookId])
  @@map("book_subjects")
}

// SCRUM-18: persistencia compartida para calcular disponibilidad.
// Los CHECK e índices parciales se mantienen en la migración SQL.
model QueueEntry {
  id          String       @id @default(uuid()) @db.Uuid
  userId      String       @map("user_id") @db.Uuid
  bookId      String       @map("book_id") @db.Uuid
  orderSeq    BigInt       @unique @default(autoincrement()) @map("order_seq")
  joinedAt    DateTime     @default(now()) @map("joined_at") @db.Timestamptz(6)
  state       String       @default("WAITING") @db.Text
  closedAt    DateTime?    @map("closed_at") @db.Timestamptz(6)
  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  book        Book         @relation(fields: [bookId], references: [id], onDelete: Restrict)
  reservation Reservation?

  @@unique([id, userId, bookId])
  @@map("queue_entries")
}

model Reservation {
  id           String     @id @default(uuid()) @db.Uuid
  queueEntryId String     @unique @map("queue_entry_id") @db.Uuid
  userId       String     @map("user_id") @db.Uuid
  bookId       String     @map("book_id") @db.Uuid
  offeredAt    DateTime   @default(now()) @map("offered_at") @db.Timestamptz(6)
  expiresAt    DateTime   @map("expires_at") @db.Timestamptz(6)
  state        String     @default("HELD") @db.Text
  closedAt     DateTime?  @map("closed_at") @db.Timestamptz(6)
  user         User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  book         Book       @relation(fields: [bookId], references: [id], onDelete: Restrict)
  queueEntry   QueueEntry @relation(fields: [queueEntryId, userId, bookId], references: [id, userId, bookId], onDelete: Restrict)
  loan         Loan?

  @@unique([id, userId, bookId])
  // Prisma exige la clave completa para representar esta relación 1:1 compuesta.
  @@unique([queueEntryId, userId, bookId])
  @@map("reservations")
}

model Loan {
  id            String       @id @default(uuid()) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  bookId        String       @map("book_id") @db.Uuid
  reservationId String?      @unique @map("reservation_id") @db.Uuid
  startedAt     DateTime     @default(now()) @map("started_at") @db.Timestamptz(6)
  dueAt         DateTime     @map("due_at") @db.Timestamptz(6)
  closedAt      DateTime?    @map("closed_at") @db.Timestamptz(6)
  user          User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  book          Book         @relation(fields: [bookId], references: [id], onDelete: Restrict)
  reservation   Reservation? @relation(fields: [reservationId, userId, bookId], references: [id, userId, bookId], onDelete: Restrict)

  @@unique([reservationId, userId, bookId])
  @@map("loans")
}
